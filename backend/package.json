{
  "name": "backend",
  "module": "server.ts",
  "type": "commonjs",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@buntok/core": "^2.1.13"
  },
  "scripts": {
    "dev": "bun --watch server.ts",
    "build": "bunx buntok build",
    "start": "bun .buntok/server.js",
    "check": "bunx @biomejs/biome check --write .",
    "format": "bunx @biomejs/biome format --write .",
    "lint": "bunx @biomejs/biome lint ."
  }
}
